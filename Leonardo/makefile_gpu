FC    	= mpif90
LD	= $(FC)
RM	= /bin/rm -f
FOPTS   = -fast -acc -gpu=managed,cuda12.9 -Mfree -Mpreprocess  -module=./set_run/sc_compiled
FFLAGS  = $(FOPTS)
#LIBS   = -I$(MPI_PATH) -cudalib=cufft #MPI path if using spectrum
LIBS    = -cudalib=cufft -llapack -lblas
# NVTX ranges (one per time step, main.f90) for nsys; set NVTX = 0 if the link fails
NVTX    = 1
ifeq ($(NVTX),1)
FOPTS  += -DUSE_NVTX
LIBS   += -cudalib=nvtx
endif

LDFLAGS	= $(FOPTS)

FLWOBJS =  $(shell cat list_source.list)

OBJS	= $(FLWOBJS)
EXEC    =  ./set_run/sc_compiled/flow36

$(EXEC):	$(OBJS)
	$(LD) $(FFLAGS) $(OBJS) $(LIBS) -o $@

clean:
	$(RM) $(OBJS) $(EXEC)

.SUFFIXES: .o

.f90.o:
	$(FC)  -c $(FFLAGS) $<
